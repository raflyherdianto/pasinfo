{
  "name": "wildan-projects",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "predev": "node frontend/scripts/kill-port.js 5173 8080",
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"cyan,green\" --names \"frontend,backend\" \"npm run dev --prefix frontend\" \"npm run backend\"",
    "frontend": "npm run dev --prefix frontend",
    "backend": "cd backend && go run ./cmd/api",
    "build": "npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}

# =============================================================================
# Frontend environment variables — Pasinfo Portal
# Copy to ~/pasinfo/frontend/.env on the Oracle VM
# IMPORTANT: Vite bakes VITE_* vars into the bundle at BUILD TIME.
#            If this value changes, you must rebuild the image.
# DO NOT commit this file or .env to the repository
# =============================================================================

# ── API URL ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://api.pasuruaninfo.com

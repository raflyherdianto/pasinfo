# =============================================================================
# Backend environment variables — Pasinfo API
# Copy to ~/pasinfo/backend/.env on the Oracle VM
# DO NOT commit this file or .env to the repository
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
PORT=8080

# Body size limit in MB (default 10)
BODY_LIMIT_MB=10

# Enable HSTS header (set to "true" only when TLS is terminated at this service)
HTTPS=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — minimum 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── Database (PostgreSQL / SQLite) ───────────────────────────────────────────
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pasinfo
DB_SSLMODE=disable
DB_PATH=/app/data/pasinfo.db

# ── Seeder ────────────────────────────────────────────────────────────────────
# Password for seeding default users (admin, penulis, editor, member)
SEED_USER_PASSWORD=pasuruaninfo123

# ── File uploads ──────────────────────────────────────────────────────────────
# Directory inside container where uploaded images are stored (volume-mounted)
UPLOAD_DIR=/app/uploads/images
